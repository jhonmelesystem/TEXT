# Copia este archivo como ".env" y rellena los valores.
# El archivo .env NUNCA se sube a GitHub.
PORT=3000

# Direccion publica de la app (la usa el QR de invitacion).
# En Railway: https://tu-servicio.up.railway.app
APP_URL=http://localhost:3000

# Base de datos. En Railway se usan las variables MYSQLHOST, MYSQLPORT,
# MYSQLUSER, MYSQLPASSWORD y MYSQLDATABASE en lugar de estas.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=pon_aqui_tu_password
DB_NAME=text_app

# Clave larga y aleatoria para firmar las sesiones. Generala con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria

# Correo, opcion 1 (Railway Hobby): API de Brevo
# BREVO_API_KEY=
# MAIL_FROM_EMAIL=tu_remitente_verificado@ejemplo.com
# MAIL_FROM_NAME=text
# Correo, opcion 2: SMTP (en tu PC)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="text <no-reply@text.app>"
# Sin proveedor de correo, el codigo sale en la terminal (en produccion solo con esto en true):
# SHOW_CODES_IN_LOGS=true

# Archivos subidos. En Railway apuntan al volumen: /data/uploads y /data/tmp
# UPLOAD_DIR=/data/uploads
# TMP_DIR=/data/tmp

# Videos: duracion maxima en segundos y tamano maximo del original en MB (0 = sin limite)
VIDEO_MAX_SECONDS=60
VIDEO_MAX_UPLOAD_MB=1024

# Solo si FFmpeg no esta en el PATH de Windows:
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
