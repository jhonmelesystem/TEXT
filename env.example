# Copia este archivo como ".env" y rellena los valores.
# El archivo .env NUNCA se sube a GitHub.
PORT=3000

# Direccion que lleva el QR de invitacion. Para probar con un telefono
# (mismo Wi-Fi) usa la IP de tu PC, por ejemplo http://192.168.1.10:3000
APP_URL=http://localhost:3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=pon_aqui_tu_password
DB_NAME=text_app

# Clave larga y aleatoria para firmar las sesiones. Generala con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria

# Correo. Si SMTP_HOST esta vacio, el codigo se muestra en la terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="text <no-reply@text.app>"

# Videos: duracion maxima en segundos y tamano maximo del original en MB (0 = sin limite)
VIDEO_MAX_SECONDS=60
VIDEO_MAX_UPLOAD_MB=1024

# Solo si FFmpeg no esta en el PATH de Windows:
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe
