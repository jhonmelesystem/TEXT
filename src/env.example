# Copia este archivo como ".env" y rellena los valores
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=pon_aqui_tu_password
DB_NAME=text_app

# Clave larga y aleatoria para firmar las sesiones
JWT_SECRET=cambia_esto_por_un_texto_largo_y_aleatorio

# Correo (opcional en desarrollo: si SMTP_HOST esta vacio,
# el codigo se muestra en la terminal)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="text <no-reply@text.app>"

# Direccion publica de la app (se usa para armar los links de invitacion)
APP_URL=http://localhost:3000
